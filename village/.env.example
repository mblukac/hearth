# Copy to .env in the repository root and fill in your own key. Never commit .env.
# One OpenRouter key runs both models.
OPENROUTER_API_KEY=
# Optional: other model versions on OpenRouter (defaults shown).
# VILLAGE_JEV_MODEL=typesafe/jev-1.14
# VILLAGE_LUNA_MODEL=openai/gpt-6-luna
# Calls per wall-clock minute. Simulation speed does not raise these limits.
VILLAGE_JEV_RPM=60
VILLAGE_LUNA_RPM=12
VILLAGE_SESSION_CALL_LIMIT=3000
